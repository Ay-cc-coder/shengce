# 仅源码构建方式（docker-compose.build.yml）使用本文件；
# 默认安装直接改 docker-compose.yml 里的 environment。
# 管理台密码。留空时首次启动会生成到 data/admin-password.txt。
ADMIN_PASSWORD=

# 手机 WebDAV 账号。密码留空时首次启动会生成到 data/dav-password.txt。
DAV_USERNAME=audiowatch
DAV_PASSWORD=

# 对外访问地址。用 Caddy/域名时填写，例如 https://record.example.com
PUBLIC_URL=

# 服务端口与监听地址
APP_PORT=3000
APP_BIND=0.0.0.0

# 时区，影响通话统计和“今天”的边界。
TZ=Asia/Shanghai

# 语音转写：first run 会下载模型到 data/models。
# 中文电话录音建议 small 或 medium；CPU 上 medium 会明显更慢。
WHISPER_MODEL=small
WHISPER_LANGUAGE=zh
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# 限制 CTranslate2 使用的 CPU 线程数；NAS 上建议 2。
WHISPER_CPU_THREADS=2
# 让模型优先输出简体中文；可留空。
WHISPER_PROMPT=以下是普通话电话录音，请用简体中文转写。

# faster 使用 faster-whisper；fake 读取 demo/data 中的样例（开发用）。
ASR_ENGINE=faster

# 置 0 可暂停处理队列，只保留 WebUI 和上传。
START_WORKER=1

# 单文件上限（MB）
MAX_UPLOAD_MB=512

# “接入手机”页是否显示 WebDAV 密码；设 0 则只显示占位。
SHOW_DAV_PASSWORD=1

# 可选：OpenAI 兼容的摘要模型。留空则完全使用本机规则。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 演示：首次在空资料库启动时写入 13 段虚构录音和待办。生产请保持 0。
DEMO_MODE=0

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.liseng.audiowatch.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/AudioWatchDaemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>UserName</key>
	<string>root</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/var/mobile/Library/Logs/AudioWatch.log</string>
	<key>StandardErrorPath</key>
	<string>/var/mobile/Library/Logs/AudioWatch.log</string>
</dict>
</plist>
